ASPNETCORE_ENVIRONMENT=Production
NODE_HTTP_PORT=7042
NODE_GRPC_PORT=7142

NODE_DB_PATH=/data/full-node.db
NODE_DB_PASSWORD=change-this-node-db-password
NODE_ADMIN_TOKEN=change-this-admin-token
WEBHOOK_SECRET=change-this-webhook-secret
ORACLE_PUBLIC_KEY=auto
ORACLE_PRIVATE_KEY_PASSWORD=change-this-oracle-key-password
ORACLE_KEY_PATH=/data/oracle_key.dat

CONSENSUS_ENABLE_POC=true
CONSENSUS_REQUIRE_PROOF_OF_WORK=false
CONSENSUS_ACCEPT_P2P_BLOCKS_AS_FINAL=false
CONSENSUS_FINALITY_MODE=Raft
CONSENSUS_PRODUCER_KEY_PATH=/data/producer-key.dat
CONSENSUS_PRODUCER_KEY_PASSWORD=change-this-producer-key-password

RAFT_PORT=6042
RAFT_NODE_ID=full-node-1
RAFT_PUBLIC_ENDPOINT=full-node.example.com:6042
RAFT_LOG_PATH=/data/raft-log
RAFT_USE_PERSISTENT_MEMBERSHIP=true
RAFT_MEMBERSHIP_PATH=/data/raft-membership
RAFT_SNAPSHOT_PATH=/data/raft-snapshots
RAFT_PEER_ID=bootstrap-main-1
RAFT_PEER_ENDPOINT=bootstrap.example.com:6041

P2P_NODE_ID=
P2P_BOOTSTRAP_GRPC_URL=https://bootstrap.example.com:7141
P2P_SYNC_TOKEN=change-this-sync-token
P2P_REGISTRATION_TOKEN=
P2P_IDENTITY_KEY_PATH=/data/node-identity.p256.key
P2P_DISCOVERY_INTERVAL_SECONDS=60
P2P_ALLOW_REGISTRATION_TOKEN_FALLBACK=false

IROH_LOCAL_API_TOKEN=change-this-local-sidecar-token
IROH_SECRET_KEY_PATH=/data/iroh-secret.key
IROH_RELAY_MODE=default
UPDATE_MANIFEST_URL=
IROH_LOG=info,nexus_iroh_sidecar=info
