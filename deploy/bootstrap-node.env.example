ASPNETCORE_ENVIRONMENT=Production
NODE_HTTP_PORT=7041
NODE_GRPC_PORT=7141

NETWORK_ID=nexus-main
NETWORK_BOOTSTRAP_HTTP_URL=https://bootstrap.example.com
NETWORK_BOOTSTRAP_GRPC_URL=https://bootstrap.example.com:7141
NETWORK_BOOTSTRAP_IROH_URL=
NETWORK_TRUSTED_BOOTSTRAP_NODE_ID=bootstrap-main-1
NETWORK_TRUSTED_BOOTSTRAP_FINGERPRINT=

NODE_DB_PATH=/data/bootstrap-node.db
NODE_ROLE=Bootstrap
NODE_DB_PASSWORD=change-this-node-db-password
NODE_ADMIN_TOKEN=change-this-admin-token
WEBHOOK_SECRET=change-this-webhook-secret
ORACLE_PUBLIC_KEY=auto
ORACLE_PRIVATE_KEY_PASSWORD=change-this-oracle-key-password
ORACLE_KEY_PATH=/data/oracle_key.dat

CONSENSUS_ENABLE_POC=true
CONSENSUS_REQUIRE_PROOF_OF_WORK=false
CONSENSUS_ACCEPT_P2P_BLOCKS_AS_FINAL=false
CONSENSUS_FINALITY_MODE=Raft
CONSENSUS_PRODUCER_KEY_PATH=/data/producer-key.dat
CONSENSUS_PRODUCER_KEY_PASSWORD=change-this-producer-key-password

RAFT_PORT=6041
RAFT_TRANSPORT=Tcp
RAFT_NODE_ID=bootstrap-main-1
RAFT_PUBLIC_ENDPOINT=bootstrap.example.com:6041
RAFT_IROH_NODE_ID=
RAFT_IROH_CONTROL_ENDPOINT=127.0.0.1:60411
RAFT_IROH_NODE_LISTEN_ENDPOINT=127.0.0.1:60410
RAFT_LOG_PATH=/data/raft-log
RAFT_USE_PERSISTENT_MEMBERSHIP=true
RAFT_MEMBERSHIP_PATH=/data/raft-membership
RAFT_SNAPSHOT_PATH=/data/raft-snapshots
RAFT_PEER_ID=
RAFT_PEER_ENDPOINT=

P2P_NODE_ID=bootstrap-main-1
P2P_PUBLIC_URL=https://bootstrap.example.com
P2P_SYNC_TOKEN=change-this-sync-token
P2P_REGISTRATION_TOKEN=
P2P_IDENTITY_KEY_PATH=/data/node-identity.p256.key
P2P_DISCOVERY_INTERVAL_SECONDS=60
P2P_ALLOW_REGISTRATION_TOKEN_FALLBACK=false
P2P_MAX_REGISTERED_PEERS=5000
P2P_MAX_REGISTRATIONS_PER_MINUTE_PER_ADDRESS=30
IROH_ENABLED=false
IROH_SIDECAR_URL=http://iroh-sidecar:49152
IROH_LOCAL_API_TOKEN=
UPDATE_MANIFEST_URL=
