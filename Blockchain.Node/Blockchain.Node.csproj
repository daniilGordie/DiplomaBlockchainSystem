    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>07f46673-f560-4b48-b279-56a2853f4845</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\blockchain.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.76.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blockchain.Application\Blockchain.Application.csproj" />
    <ProjectReference Include="..\Blockchain.Core\Blockchain.Core.csproj" />
    <ProjectReference Include="..\Blockchain.Infrastructure\Blockchain.Infrastructure.csproj" />
  </ItemGroup>

</Project>
