<div class="diff-viewer-container rounded border border-secondary" style="background-color: #ffffff; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.85rem; overflow-x: auto;">
    @if (string.IsNullOrWhiteSpace(DiffText))
    {
        <div class="p-4 text-muted text-center">Select a commit with an IPFS patch to inspect the diff.</div>
    }
    else
    {
        <table class="w-100" style="border-collapse: collapse;">
            <tbody>
                @foreach (var line in DiffText.Split('\n'))
                {
                    if (line.StartsWith("+++") || line.StartsWith("---"))
                    {
                        <tr style="background-color: #f3f2f1; font-weight: bold;">
                            <td class="p-1 px-3 text-white-50" colspan="2">@line</td>
                        </tr>
                    }
                    else if (line.StartsWith("@@"))
                    {
                        <tr style="background-color: #deecf9;">
                            <td class="p-1 px-3 text-info" colspan="2">@line</td>
                        </tr>
                    }
                    else if (line.StartsWith("+"))
                    {
                        <tr style="background-color: #dff6dd;">
                            <td class="text-end text-success pe-2 user-select-none" style="width: 40px; border-right: 1px solid #d2d0ce;">+</td>
                            <td class="p-1 px-3 text-success">@line</td>
                        </tr>
                    }
                    else if (line.StartsWith("-"))
                    {
                        <tr style="background-color: #fde7e9;">
                            <td class="text-end text-danger pe-2 user-select-none" style="width: 40px; border-right: 1px solid #d2d0ce;">-</td>
                            <td class="p-1 px-3 text-danger">@line</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="text-end text-white-50 pe-2 user-select-none" style="width: 40px; border-right: 1px solid #d2d0ce;"></td>
                            <td class="p-1 px-3" style="color: #323130;">@line</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public string DiffText { get; set; } = "";
}
