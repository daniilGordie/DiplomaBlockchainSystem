@using Blockchain.UI.Models
@using Blockchain.UI.Services
@using Blockchain.UI.Application.Clients
@using Microsoft.JSInterop
@inject KeyService MyKeyService
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-backdrop-custom">
        <div class="glass-card p-0 modal-content-custom animate-pop" style="max-width: 640px; margin: 50px auto;">

            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-dark">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-primary px-3 py-2">
                        @(IsNewTask ? "New work item" : TaskModel.Id)
                    </span>
                    @if (!IsNewTask)
                    {
                        <span style="color: #adb5bd; font-size: 0.9rem;">Created by <strong class="text-white">@TaskModel.Creator</strong></span>
                    }
                </div>
                <button class="btn-close" @onclick="Close"></button>
            </div>

            <div class="p-4">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Title</label>
                    <input type="text" @bind="TaskModel.Title" class="form-control" placeholder="Enter work item title" aria-label="Work item title" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Description</label>
                    <textarea @bind="TaskModel.Description" class="form-control" rows="4" placeholder="Describe the work item" aria-label="Work item description"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small fw-bold">Assignee</label>
                        <select @bind="TaskModel.Assignee" class="form-select" aria-label="Assignee">
                            <option value="">Unassigned</option>
                            @foreach (var member in ProjectMembers)
                            {
                                <option value="@member">@member</option>
                            }
                        </select>
                        @if (!ProjectMembers.Any())
                        {
                            <div class="small text-warning mt-1">No project members are available for assignment.</div>
                        }
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small fw-bold">State</label>
                        <select @bind="TaskModel.Status" class="form-select" aria-label="Work item state">
                            <option value="@ProjectTaskStatus.Todo">To Do</option>
                            <option value="@ProjectTaskStatus.InProgress">In Progress</option>
                            <option value="@ProjectTaskStatus.Done">Done</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded border border-secondary bg-dark">
                    <h6 class="text-white mb-3 d-flex align-items-center gap-2">
                        Transaction registration
                    </h6>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small">@errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-muted small">Wallet file (wallet.json)</label>
                        <div class="input-group input-group-sm">
                            <input type="file" @ref="walletFileInput" class="form-control" accept=".json,application/json" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="LoadKeystoreFile">Load</button>
                        </div>
                        @if (keystoreContent != null)
                        {
                            <div class="text-success small mt-1">Wallet file loaded</div>
                        }
                    </div>

                    <div class="mb-0">
                        <label class="form-label text-muted small">Wallet password</label>
                        <input type="password"
                               @bind="walletPassword"
                               class="form-control form-control-sm"
                               disabled="@isPasskeyWallet"
                               placeholder="Enter wallet password"
                               aria-label="Wallet password"
                               autocomplete="current-password"
                               name="wallet-password" />
                        @if (isPasskeyWallet)
                        {
                            <div class="text-info small mt-2">Passkey wallet detected. Password is not required, system passkey dialog will be used.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="p-3 text-end d-flex justify-content-between align-items-center bg-dark border-top border-secondary">
                <div class="text-muted font-monospace d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                    Secured by keystore signature
                </div>
                <div>
                    <button class="btn btn-outline-secondary me-2 fw-semibold" @onclick="Close">Cancel</button>
                    <button class="btn btn-primary fw-semibold"
                            @onclick="HandleSaveAndMine"
                            disabled="@(!CanSubmitTask())">
                        @(IsNewTask ? "Sign & Create" : "Sign & Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsNewTask { get; set; }
    [Parameter] public ProjectTask TaskModel { get; set; } = new();
    [Parameter] public List<string> ProjectMembers { get; set; } = new();
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public EventCallback<TaskSigningRequest> OnSaveWithCredentials { get; set; }

    private string? keystoreContent;
    private string? walletPassword;
    private string? errorMessage;
    private bool isPasskeyWallet;
    private ElementReference walletFileInput;

    private async Task Close() => await IsOpenChanged.InvokeAsync(false);

    private async Task LoadKeystoreFile()
    {
        try
        {
            errorMessage = null;
            keystoreContent = await JS.InvokeAsync<string>("readTextFromFileInput", walletFileInput);
            if (string.IsNullOrWhiteSpace(keystoreContent))
            {
                errorMessage = "Choose a wallet file first.";
                return;
            }

            // CHANGED: detect passkey wallet mode from keystore metadata.
            isPasskeyWallet = keystoreContent.Contains("\"ProtectionMode\":\"passkey\"", StringComparison.OrdinalIgnoreCase);
            if (isPasskeyWallet)
            {
                walletPassword = string.Empty;
            }
        }
        catch (Exception)
        {
            errorMessage = "Error reading wallet file.";
        }
    }

    private async Task HandleSaveAndMine()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(keystoreContent) || (!isPasskeyWallet && string.IsNullOrEmpty(walletPassword)))
        {
            errorMessage = isPasskeyWallet
                ? "Load the wallet file."
                : "Load the wallet file and enter the password.";
            return;
        }

        if (RequiresAssigneeForStatus() && !HasValidAssignee())
        {
            errorMessage = "Assign a project member before setting state to In Progress or Done.";
            return;
        }

        if (HasAssigneeValue() && !IsProjectMember(TaskModel.Assignee))
        {
            errorMessage = "Assignee must be an existing project member.";
            return;
        }

        try
        {
            var taskEvent = new TaskEvent
                {
                    Type = IsNewTask ? "Create" : "Move",
                    TaskId = TaskModel.Id,
                    Title = TaskModel.Title,
                    Description = TaskModel.Description,
                    Assignee = NormalizeAssignee(TaskModel.Assignee),
                    Status = (int)TaskModel.Status,
                    ProjectId = TaskModel.ProjectId,
                    User = MyKeyService.UserName,
                    ParentTaskId = TaskModel.ParentTaskId
                };

            // CHANGED: signing is performed in parent flow with mode-aware logic (password/passkey).
            await OnSaveWithCredentials.InvokeAsync(new TaskSigningRequest(taskEvent, keystoreContent, walletPassword ?? string.Empty));

            walletPassword = null;
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = "Error: " + ex.Message;
        }
    }

    private bool CanSubmitTask()
    {
        if (keystoreContent == null || (!isPasskeyWallet && string.IsNullOrEmpty(walletPassword)))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(TaskModel.Title))
        {
            return false;
        }

        if (RequiresAssigneeForStatus() && !HasValidAssignee())
        {
            return false;
        }

        return !HasAssigneeValue() || IsProjectMember(TaskModel.Assignee);
    }

    private bool RequiresAssigneeForStatus() =>
        TaskModel.Status is ProjectTaskStatus.InProgress or ProjectTaskStatus.Done;

    private bool HasAssigneeValue() =>
        !string.IsNullOrWhiteSpace(TaskModel.Assignee) &&
        !string.Equals(TaskModel.Assignee.Trim(), "None", StringComparison.OrdinalIgnoreCase);

    private bool HasValidAssignee() => HasAssigneeValue() && IsProjectMember(TaskModel.Assignee);

    private bool IsProjectMember(string? userName) =>
        !string.IsNullOrWhiteSpace(userName) &&
        ProjectMembers.Any(member => string.Equals(member, userName.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string NormalizeAssignee(string? assignee) =>
        string.IsNullOrWhiteSpace(assignee) ||
        string.Equals(assignee.Trim(), "None", StringComparison.OrdinalIgnoreCase)
            ? ""
            : assignee.Trim();
}
