@using Blockchain.UI.Models
@using Blockchain.UI.Services
@using System.IO
@inject KeyService MyKeyService

@if (IsOpen)
{
    <div class="modal-backdrop-custom" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(5px);">
        <div class="glass-card p-0 modal-content-custom animate-pop" style="background: #1e1e24; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); max-width: 600px; margin: 50px auto;">

            <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color: rgba(255,255,255,0.1) !important; background: rgba(255,255,255,0.02);">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                        @(IsNewTask ? "New Issue" : TaskModel.Id)
                    </span>
                    @if (!IsNewTask)
                    {
                        <span style="color: #adb5bd; font-size: 0.9rem;">Created by <strong class="text-white">@TaskModel.Creator</strong></span>
                    }
                </div>
                <button class="btn-close btn-close-white" @onclick="Close"></button>
            </div>

            <div class="p-4">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Заголовок задачи</label>
                    <input type="text" @bind="TaskModel.Title" class="form-control bg-dark text-white border-secondary" placeholder="Что нужно сделать?" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Описание</label>
                    <textarea @bind="TaskModel.Description" class="form-control bg-dark text-white border-secondary" rows="4" placeholder="Детали задачи..."></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small fw-bold">Исполнитель</label>
                        <input type="text" @bind="TaskModel.Assignee" class="form-control bg-dark text-white border-secondary" placeholder="username" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small fw-bold">Статус</label>
                        <select @bind="TaskModel.Status" class="form-select bg-dark text-white border-secondary">
                            <option value="@ProjectTaskStatus.Todo">To Do</option>
                            <option value="@ProjectTaskStatus.InProgress">In Progress</option>
                            <option value="@ProjectTaskStatus.Done">Done</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded" style="background: rgba(13, 110, 253, 0.05); border: 1px dashed rgba(13, 110, 253, 0.3);">
                    <h6 class="text-white mb-3 d-flex align-items-center gap-2">
                        <span style="font-size: 1.2rem;">🔑</span> Transaction registration
                    </h6>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small">@errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-muted small">Файл кошелька (wallet.json)</label>
                        <InputFile OnChange="LoadKeystoreFile" class="form-control form-control-sm bg-dark text-white border-secondary" />
                        @if (keystoreContent != null)
                        {
                            <div class="text-success small mt-1">✔ Файл загружен</div>
                        }
                    </div>

                    <div class="mb-0">
                        <label class="form-label text-muted small">Пароль кошелька</label>
                        <input type="password" @bind="walletPassword" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Пароль для расшифровки ключа..." />
                    </div>
                </div>
            </div>

            <div class="p-3 text-end d-flex justify-content-between align-items-center" style="background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.1); border-radius: 0 0 12px 12px;">
                <div class="text-muted font-monospace d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 10px; height: 10px;"></span>
                    Secured by Keystore
                </div>
                <div>
                    <button class="btn btn-outline-secondary me-2 fw-bold" @onclick="Close">Cancel</button>
                    <button class="btn btn-primary fw-bold shadow"
                            @onclick="HandleSaveAndMine"
                            disabled="@(keystoreContent == null || string.IsNullOrEmpty(walletPassword) || string.IsNullOrEmpty(TaskModel.Title))">
                        @(IsNewTask ? "Sign & Create" : "Sign & Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .animate-pop {
        animation: pop 0.3s cubic-bezier(0.26, 0.53, 0.74, 1.48);
    }
    @System.Text.RegularExpressions.Regex.Unescape("@") keyframes pop {
        0%

    {
        opacity: 0;
        transform: scale(0.7);
    }

    100% {
        opacity: 1;
        transform: scale(1);
    }

    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsNewTask { get; set; }
    [Parameter] public ProjectTask TaskModel { get; set; } = new();
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public EventCallback<(TaskEvent Event, string Keystore, string Password)> OnSaveWithCredentials { get; set; }

    private string? keystoreContent;
    private string? walletPassword;
    private string? errorMessage;

    private async Task Close() => await IsOpenChanged.InvokeAsync(false);

    private async Task LoadKeystoreFile(InputFileChangeEventArgs e)
    {
        try
        {
            errorMessage = null;
            var file = e.File;
            using var stream = file.OpenReadStream();
            using var reader = new StreamReader(stream);
            keystoreContent = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Ошибка при чтении файла.";
        }
    }

    private async Task HandleSaveAndMine()
    {
        errorMessage = null;

        if (string.IsNullOrEmpty(keystoreContent) || string.IsNullOrEmpty(walletPassword))
        {
            errorMessage = "Загрузите файл и введите пароль.";
            return;
        }

        try
        {
            var taskEvent = new TaskEvent
                {
                    Type = IsNewTask ? "Create" : "Move",
                    TaskId = TaskModel.Id,
                    Title = TaskModel.Title,
                    Description = TaskModel.Description,
                    Assignee = TaskModel.Assignee,
                    Status = (int)TaskModel.Status,
                    ProjectId = TaskModel.ProjectId,
                    User = MyKeyService.UserName 
                };

            string jsonData = System.Text.Json.JsonSerializer.Serialize(taskEvent);

            string signature = MyKeyService.SignDataWithKeystore(keystoreContent, walletPassword, jsonData);

            await OnSaveWithCredentials.InvokeAsync((taskEvent, keystoreContent, walletPassword));

            walletPassword = null;
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = "Ошибка: " + ex.Message;
        }
    }
}