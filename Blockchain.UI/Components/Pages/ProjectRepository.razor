@page "/repo/{ProjectId}"
@using Blockchain.Node
@using Blockchain.UI.Services
@using Blockchain.UI.Models
@using Blockchain.UI.Components
@using Blockchain.UI.Application.Clients
@inject IProjectRepositoryDataService RepositoryDataService
@inject IIpfsGatewayClient IpfsGatewayClient
@inject NavigationManager Nav
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="dashboard-container p-4">
    <div class="glass-card p-4 mb-4">
        <div>
            <button class="btn btn-sm btn-outline-secondary mb-3" @onclick='() => Nav.NavigateTo("/")'>Back to Dashboard</button>
            <h1 class="section-shell__title mb-1">Project Repository</h1>
            <div class="text-muted font-monospace small">@ProjectId</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="glass-card p-3 h-100">
                <h5 class="text-white mb-3">Commit Records</h5>
                <div class="chain-scroll-view" style="max-height: 700px; overflow-y: auto;">
                    @if (!Commits.Any())
                    {
                        <div class="text-muted text-center py-4">No commit records anchored for this project.</div>
                    }
                    else
                    {
                        @foreach (var c in Commits)
                        {
                            <div class="p-3 mb-2 rounded border @(selectedCommitHash == c.CommitHash ? "border-warning bg-dark" : "border-secondary hover-bg")"
                                 style="cursor: pointer;" @onclick="() => LoadDiff(c)">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="badge bg-primary">@ShortCommit(c.CommitHash)</span>
                                    <small class="text-muted">@c.Author</small>
                                </div>
                                <div class="text-white small fw-bold">@c.Message</div>
                                @if (!string.IsNullOrWhiteSpace(c.Provider))
                                {
                                    <div class="small text-white-50">@c.Provider</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.Branch))
                                {
                                    <div class="small text-white-50">branch: @c.Branch</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="glass-card p-0 h-100 d-flex flex-column overflow-hidden">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between">
                    <h5 class="m-0 text-white">@(string.IsNullOrEmpty(selectedCommitHash) ? "Project Artifacts" : "Changes View")</h5>
                    @if (!string.IsNullOrEmpty(selectedCommitHash))
                    {
                        <button class="btn btn-sm btn-outline-light" @onclick="() => selectedCommitHash = null">Close Diff</button>
                    }
                </div>

                <div class="flex-grow-1 p-3" style="overflow-y: auto;">
                    @if (string.IsNullOrEmpty(selectedCommitHash))
                    {
                        <table class="table table-dark">
                            <thead>
                                <tr><th>Artifact</th><th>IPFS CID</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                @if (!Artifacts.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No artifacts anchored for this project.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var a in Artifacts)
                                    {
                                        <tr>
                                            <td>@a.FileName</td>
                                            <td class="font-monospace small text-info">@ShortHash(a.FileHash)</td>
                                            <td><a href="@BuildIpfsGatewayUrl(a.FileHash)" target="_blank" class="btn btn-sm btn-outline-info">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else if (isLoadingDiff)
                    {
                        <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
                    }
                    else
                    {
                        <DiffViewer DiffText="@currentDiffText" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    private List<CommitPayloadUI> Commits = new();
    private List<ArtifactPayloadUI> Artifacts = new();
    private string? selectedCommitHash;
    private string currentDiffText = "";
    private bool isLoadingDiff = false;
    private string IpfsGatewayUrl => (Config["IpfsGatewayUrl"] ?? "http://127.0.0.1:8080/ipfs").Trim().TrimEnd('/');

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        var data = await RepositoryDataService.LoadAsync(ProjectId);
        Commits = data.Commits.ToList();
        Artifacts = data.Artifacts.ToList();
    }

    private async Task LoadDiff(CommitPayloadUI commit)
    {
        if (string.IsNullOrEmpty(commit.PatchCid)) return;
        selectedCommitHash = commit.CommitHash;
        isLoadingDiff = true;
        try
        {
            currentDiffText = await IpfsGatewayClient.GetTextAsync(IpfsGatewayUrl, commit.PatchCid);
        }
        catch { currentDiffText = "Error loading data from IPFS."; }
        finally { isLoadingDiff = false; }
    }

    private string BuildIpfsGatewayUrl(string cid) => $"{IpfsGatewayUrl}/{cid}";
    private static string ShortCommit(string hash) => string.IsNullOrWhiteSpace(hash) ? "unknown" : (hash.Length <= 7 ? hash : hash[..7]);
    private static string ShortHash(string hash) => string.IsNullOrWhiteSpace(hash) ? "no cid" : (hash.Length <= 14 ? hash : $"{hash[..14]}...");
}
