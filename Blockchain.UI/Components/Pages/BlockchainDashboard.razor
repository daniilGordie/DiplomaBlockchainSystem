    private async Task RegisterLocalCommit()
    {
        var cleanHash = localCommitHash?.Trim().ToLowerInvariant();

        bool isValidGitHash = !string.IsNullOrEmpty(cleanHash) &&
                              cleanHash.Length >= 7 &&
                              cleanHash.Length <= 40 &&
                              System.Text.RegularExpressions.Regex.IsMatch(cleanHash, "^[a-f0-9]+$");

        if (!isValidGitHash || string.IsNullOrWhiteSpace(localCommitMessage))
        {
            return;
        }

        var payload = new
        {
            Type = "CodeCommit",
            User = MyKeyService.UserName,
            ProjectId = CurrentProjectId,
            Repository = localRepoName,
            CommitHash = cleanHash, 
            Message = localCommitMessage,
            Timestamp = DateTime.UtcNow.ToString("O")
        };

        await SendJsonBlock(payload);

        localCommitHash = "";
        localCommitMessage = "";
    }

