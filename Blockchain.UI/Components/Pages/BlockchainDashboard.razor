    private (string Hash, long Nonce) MineBlockData(string prevHash, string timestamp, string data, string pubKey, int difficulty)
    {
        using var sha256 = System.Security.Cryptography.SHA256.Create();
        string target = new string('0', difficulty);
        long nonce = 0;
        string hash = "";

        while (true)
        {
            string rawData = $"{prevHash}{timestamp}{data}{pubKey}{nonce}";
            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(rawData);
            hash = BitConverter.ToString(sha256.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant();

            if (hash.StartsWith(target))
            {
                return (hash, nonce);
            }
            nonce++;
        }
    }

    private async Task SendJsonBlock<T>(T payload)
    {
        try
        {
            isMining = true;
            StateHasChanged();

            string json = JsonSerializer.Serialize(payload);

            string targetChannel = (json.Contains("\"Type\":\"CreateProject\"") || json.Contains("\"Type\":\"AssignRole\""))
                                    ? "System"
                                    : CurrentProjectId;

            var cR = await BlockchainClient.GetChainAsync(new ChainRequest
                {
                    Count = 1,
                    ChannelId = targetChannel,
                    UserName = MyKeyService.UserName ?? "Guest" 
                });

            string prevHash = cR.Blocks.Count > 0 ? cR.Blocks.Last().Hash : "0";

            string sig = MyKeyService.SignData(json);
            string timestamp = DateTime.UtcNow.ToString("O");
            string pubKey = MyKeyService.PublicKey;

            var mined = await Task.Run(() => MineBlockData(prevHash, timestamp, json, pubKey, 3));

            var blk = new BlockModel
                {
                    Data = json,
                    Timestamp = timestamp,
                    PreviousHash = prevHash,
                    Hash = mined.Hash,
                    ValidatorPublicKey = pubKey,
                    Signature = sig,
                    Nonce = mined.Nonce,
                    ChannelId = targetChannel 
                };

            var r = await BlockchainClient.ReceiveBlockAsync(blk);
            statusMessage = r.Success ? $"✅ Mined! Nonce: {mined.Nonce}" : $"❌ Rejected: {r.Message}";

            await SyncChain();
        }
        catch (Exception ex) { statusMessage = ex.Message; }
        finally { isMining = false; StateHasChanged(); }
    }

    private async Task SyncChain()
    {
        try
        {
            if (MyKeyService.IsLoggedIn)
            {
                var projRes = await BlockchainClient.GetMyProjectsAsync(new UserRequest { UserName = MyKeyService.UserName });
                myProjects = projRes.ProjectIds.ToList();
                
                if ((!myProjects.Contains(CurrentProjectId) || CurrentProjectId == "Alpha") && myProjects.Count > 0)
                {
                    CurrentProjectId = myProjects.First();
                }
            }

            var tR = await BlockchainClient.GetProjectTasksAsync(new ProjectRequest
                {
                    ProjectId = CurrentProjectId,
                    UserName = MyKeyService.UserName ?? "Guest"
                });

            Tasks = tR.Tasks.Select(t => new ProjectTask { Id = t.Id, Title = t.Title, Creator = t.Creator, Assignee = t.Assignee, Status = (ProjectTaskStatus)t.Status, ProjectId = t.ProjectId, Description = t.Description, ParentTaskId = t.ParentTaskId, BranchInfo = t.BranchInfo }).ToList();

            if (Tasks.Count > 0 || MyKeyService.IsLoggedIn) 
            {
                var cR = await BlockchainClient.GetChainAsync(new ChainRequest
                    {
                        Count = 50,
                        ChannelId = CurrentProjectId
                    });
                chain = cR.Blocks.ToList();
                RebuildLocalArtifactsAndCommits(chain);
            }
            else
            {
                chain = new List<BlockModel>();
                Commits.Clear();
                Artifacts.Clear();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sync Error: {ex.Message}");
        }
    }

    private void RebuildLocalArtifactsAndCommits(List<BlockModel> blocks)
    {
        var cL = new List<CommitPayloadUI>();
        var aL = new List<ArtifactPayloadUI>();

        Console.WriteLine($"[DEBUG] Total blocks loaded: {blocks.Count}");

        foreach (var b in blocks)
        {
            if (string.IsNullOrWhiteSpace(b.Data)) continue;

            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(b.Data);
                var root = doc.RootElement;

                string eventType = "";
                if (root.TryGetProperty("Type", out var t1)) eventType = t1.GetString() ?? "";
                else if (root.TryGetProperty("type", out var t2)) eventType = t2.GetString() ?? "";

                Console.WriteLine($"[DEBUG] Block {b.Index}: Type = '{eventType}'");

                if (eventType == "CodeCommit")
                {
                    cL.Add(new CommitPayloadUI
                        {
                            Repository = root.TryGetProperty("Repository", out var r) || root.TryGetProperty("repository", out r) ? r.GetString() : "Unknown",
                            CommitHash = root.TryGetProperty("CommitHash", out var h) || root.TryGetProperty("commitHash", out h) ? h.GetString() : "",
                            Message = root.TryGetProperty("Message", out var m) || root.TryGetProperty("message", out m) ? m.GetString() : "",
                            Author = root.TryGetProperty("User", out var u) || root.TryGetProperty("user", out u) ? u.GetString() : "Anon"
                        });
                    Console.WriteLine($"[DEBUG] 🟢 Successfully parsed CodeCommit! Hash: {cL.Last().CommitHash}");
                }
                else if (b.Data.Contains("ArtifactRegistry"))
                {
                    var a = System.Text.Json.JsonSerializer.Deserialize<ArtifactPayloadUI>(b.Data, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (a != null) aL.Add(a);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG] ❌ Failed to parse JSON in block {b.Hash}: {ex.Message}\nRaw Data: {b.Data}");
            }
        }

        Commits = cL.AsEnumerable().Reverse().ToList();
        Artifacts = aL;

        Console.WriteLine($"[DEBUG] Rebuild finished. Commits to render: {Commits.Count}");
    }

