    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || !MyKeyService.IsLoggedIn) return;

        if (file.Size > 50 * 1024 * 1024)
        {
            statusMessage = "Ошибка: Файл превышает лимит в 50MB";
            return;
        }

        isUploading = true;
        StateHasChanged();

        try
        {
            statusMessage = "Загрузка файла в локальную ноду IPFS...";
            StateHasChanged();

            string cid = await Ipfs.UploadFileAsync(file);

            statusMessage = "Якорение CID файла в блокчейн...";
            StateHasChanged();

            var payload = new
            {
                Source = "ArtifactRegistry",
                Type = "Register",
                FileName = file.Name, 
                FileHash = cid,       
                RegisteredBy = MyKeyService.UserName,
                VerificationMethod = "IPFS & Client Node"
            };

            await SendJsonBlock(payload);

            statusMessage = $"Файл успешно сохранен! CID: {cid.Substring(0, 8)}...";
        }
        catch (Exception ex)
        {
            statusMessage = $"Сбой загрузки: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

