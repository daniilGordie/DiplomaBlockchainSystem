@page "/"
@using Blockchain.Node
@using Blockchain.UI.Services
@using Blockchain.UI.Components
@using System.Text.Json
@using System.Threading
@using System.Security.Cryptography
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@using System.IO
@using Google.Protobuf
@using Microsoft.JSInterop
@using System.Linq
@using System.Collections.Generic
@using Blockchain.UI.Components.Dashboard
@using Blockchain.UI.Models
@using Microsoft.Extensions.Configuration

<PageTitle>Nexus Collaboration Platform</PageTitle>

<div class="dashboard-container">
    <DashboardHeader IsLoggedIn="MyKeyService.IsLoggedIn"
                     Projects="myProjects"
                     OwnedProjects="ownedProjects"
                     SharedProjects="sharedProjects"
                     ProjectRoles="projectRoles"
                     CurrentProjectId="@CurrentProjectId"
                     NewProjectName="@newProjectName"
                     UserNameInput="@userNameInput"
                     IsRestoreMode="isRestoreMode"
                     RestoreMnemonic="@restoreMnemonic"
                     IsMining="isMining"
                     IsGenesisModeActive="isGenesisModeActive"
                     UserName="@MyKeyService.UserName"
                     PublicKey="@MyKeyService.PublicKey"
                     OnProjectChanged="OnProjectChanged"
                     NewProjectNameChanged="OnNewProjectNameChanged"
                     UserNameInputChanged="OnUserNameInputChanged"
                     RestoreMnemonicChanged="OnRestoreMnemonicChanged"
                     OnCreateProject="CreateNewProject"
                     OnCreateWallet="CreateWallet"
                     OnToggleRestore="RestoreMode"
                     OnRestoreWallet="RestoreWallet"
                     OnCancelRestore="CancelRestoreMode"
                     OnCopyPublicKey="CopyMyPublicKey"
                     OnLogout="Logout" />

    @if (MyKeyService.IsLoggedIn && !string.IsNullOrEmpty(MyKeyService.CurrentMnemonic))
    {
        <div class="alert alert-danger mb-4 d-flex justify-content-between align-items-center gap-3">
            <div><strong>Secret phrase:</strong> <span class="font-monospace ms-2 px-2 rounded">@MyKeyService.CurrentMnemonic</span></div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CopySecretPhraseToClipboard">@MnemonicCopyButtonText</button>
        </div>
    }

    <WalletSaveModal IsOpen="showPasswordEntry"
                     Password="@(newUserPassword ?? string.Empty)"
                     Message="@passkeyModalMessage"
                     PasswordChanged="OnNewUserPasswordChanged"
                     OnDownloadWithPassword="DownloadAndFinishRegistration"
                     OnDownloadWithPasskey="DownloadWithPasskeyAndFinishRegistration" />

    @if (MyKeyService.IsLoggedIn)
    {
        <section class="workspace-overview glass-card mb-4">
            <div class="workspace-overview__copy">
                <span class="workspace-overview__eyebrow">Active workspace</span>
                <h1 class="workspace-overview__title">Nexus project collaboration ledger</h1>
                <p class="workspace-overview__description">
                    Coordinate project work, team permissions, governance decisions, artifacts, and blockchain audit activity from one workspace.
                </p>
                <div class="workspace-overview__meta">
                    <span class="workspace-pill @(CanCreateTask ? "workspace-pill--ready" : "workspace-pill--warn")">
                        @(CanCreateTask ? $"Project {CurrentProjectId}" : "Project not selected")
                    </span>
                    <span class="workspace-pill">User @(string.IsNullOrWhiteSpace(MyKeyService.UserName) ? "Unknown user" : MyKeyService.UserName)</span>
                    <span class="workspace-pill">Role @CurrentUserRoleLabel</span>
                    <span class="workspace-pill">Created @ownedProjects.Count</span>
                    <span class="workspace-pill">Shared @sharedProjects.Count</span>
                    @if (!string.IsNullOrWhiteSpace(MyKeyService.PublicKey))
                    {
                        <span class="workspace-pill">Key @ComputePublicKeyFingerprint(MyKeyService.PublicKey).Substring(0, 12)</span>
                    }
                    <span class="workspace-pill">Node @currentNodeUrl</span>
                    <button class="btn btn-sm btn-outline-light" @onclick="CopyMyPublicKey" disabled="@string.IsNullOrWhiteSpace(MyKeyService.PublicKey)">Copy Public Key</button>
                </div>
            </div>
            <div class="workspace-overview__stats">
                <div class="metric-card">
                    <span class="metric-card__label">Open tasks</span>
                    <strong class="metric-card__value">@OpenTaskCount</strong>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Completed</span>
                    <strong class="metric-card__value">@DoneTaskCount</strong>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Proposals</span>
                    <strong class="metric-card__value">@governanceProposals.Count</strong>
                </div>
                <div class="metric-card">
                    <span class="metric-card__label">Peers</span>
                    <strong class="metric-card__value">@peerUrls.Count</strong>
                </div>
            </div>
        </section>

        <div class="dashboard-tabs mb-4">
            <button class="dashboard-tab @(activeTab==ActiveTab.Board ? "is-active" : "")" @onclick="()=>activeTab=ActiveTab.Board">
                <span>Tasks</span>
                <small>@Tasks.Count items</small>
            </button>
            <button class="dashboard-tab @(activeTab==ActiveTab.Team ? "is-active" : "")" @onclick="()=>activeTab=ActiveTab.Team">
                <span>Team & RBAC</span>
                <small>@myProjects.Count projects</small>
            </button>
            <button class="dashboard-tab @(activeTab==ActiveTab.Governance ? "is-active" : "")" @onclick="LoadGovernance">
                <span>Governance</span>
                <small>@governanceProposals.Count proposals</small>
            </button>
            <button class="dashboard-tab @(activeTab==ActiveTab.Documents ? "is-active" : "")" @onclick="LoadDocuments">
                <span>Documents</span>
                <small>@documents.Count docs</small>
            </button>
            <button class="dashboard-tab @(activeTab==ActiveTab.Artifacts ? "is-active" : "")" @onclick="LoadArtifacts">
                <span>Artifacts</span>
                <small>@Artifacts.Count files</small>
            </button>
            <button class="dashboard-tab @(activeTab==ActiveTab.Analytics ? "is-active" : "")" @onclick="LoadAnalytics">
                <span>Analytics</span>
                <small>@analyticsData.TotalBlocks blocks</small>
            </button>
            <button class="dashboard-tab @(activeTab==ActiveTab.Network ? "is-active" : "")" @onclick="LoadNetwork">
                <span>Network</span>
                <small>@peerUrls.Count peers</small>
            </button>
        </div>

        <div class="tab-content mb-5">
            @if (activeTab == ActiveTab.Board)
            {
                <section class="section-shell">
                    <div class="section-shell__header">
                        <div>
                            <h3 class="section-shell__title">Delivery board</h3>
                            <p class="section-shell__subtitle">Create, sign, move, and review project tasks with blockchain-backed history.</p>
                        </div>
                        <button class="btn btn-primary fw-semibold px-3" @onclick="()=>OpenTaskModal(null)" disabled="@(!CanCreateTask)">New work item</button>
                    </div>
                    @if (!CanCreateTask)
                    {
                        <div class="alert alert-warning py-2 px-3 mb-3">Create or select a project before adding work items.</div>
                    }
                    <TaskBoard Tasks="Tasks" OnTaskClick="OpenTaskModal" OnShowHistory="ShowHistory" />
                </section>
            }

            @if (activeTab == ActiveTab.Team)
            {
                <TeamTab CurrentProjectId="@CurrentProjectId"
                         NewMemberName="@newMemberName"
                         NewMemberRole="@newMemberRole"
                         NewMemberPublicKey="@newMemberPublicKey"
                         NewMemberPublicKeyFingerprint="@newMemberPublicKeyFingerprint"
                         IsMining="isMining"
                         CurrentUserRole="@CurrentUserRoleLabel"
                         CanManageMembers="CanManageMembers"
                         NewMemberNameChanged="OnNewMemberNameChanged"
                         NewMemberRoleChanged="OnNewMemberRoleChanged"
                         NewMemberPublicKeyChanged="OnNewMemberPublicKeyChanged"
                         NewMemberPublicKeyFingerprintChanged="OnNewMemberPublicKeyFingerprintChanged"
                         OnInviteMember="InviteMember" />
            }

            @if (activeTab == ActiveTab.Governance)
            {
                <GovernanceTab CurrentProjectId="@CurrentProjectId"
                               CurrentUserName="@(MyKeyService.UserName ?? string.Empty)"
                               NewProposalTitle="@newProposalTitle"
                               NewProposalDescription="@newProposalDescription"
                               IsMining="isMining"
                               CanUseGovernance="CanCreateTask"
                               CanCreateTaskFromAccepted="CanCreateTask"
                               ImplementedProposalIds="implementedProposalIds"
                               Proposals="governanceProposals"
                               NewProposalTitleChanged="OnNewProposalTitleChanged"
                               NewProposalDescriptionChanged="OnNewProposalDescriptionChanged"
                               OnCreateProposal="CreateProposal"
                               OnVote="CastVote"
                               OnCreateTaskFromProposal="CreateTaskFromProposal" />
            }

            @if (activeTab == ActiveTab.Documents)
            {
                <DocumentsTab CurrentProjectId="@CurrentProjectId"
                              CanEdit="CanCreateTask"
                              IsMining="isMining"
                              Documents="documents"
                              Versions="documentVersions"
                              SelectedDocumentId="@selectedDocumentId"
                              DocumentTitle="@documentTitle"
                              DocumentContent="@documentContent"
                              DocumentTitleChanged="OnDocumentTitleChanged"
                              DocumentContentChanged="OnDocumentContentChanged"
                              OnSelectDocument="SelectDocument"
                              OnSaveDocument="SaveDocument"
                              OnRefresh="LoadDocuments" />
            }

            @if (activeTab == ActiveTab.Artifacts)
            {
                <ArtifactsTab CurrentProjectId="@CurrentProjectId"
                              IsUploading="isUploading"
                              IsLoggedIn="MyKeyService.IsLoggedIn"
                              StatusMessage="@statusMessage"
                              IsGitRepositoryConnecting="isGitRepositoryConnecting"
                              IpfsGatewayUrl="@IpfsGatewayUrl"
                              Artifacts="Artifacts"
                              Commits="Commits"
                              GitStatus="gitIntegrationStatus"
                              IpfsStatus="ipfsIntegrationStatus"
                              OnConnectRepository="ConnectGitRepository"
                              OnUploadFile="HandleFileUpload" />
            }
            @if (activeTab == ActiveTab.Analytics)
            {
                <AnalyticsTab Data="analyticsData"
                              Audit="securityAudit"
                              CurrentUserName="@MyKeyService.UserName"
                              AuditTrail="auditTrail" />
            }
            @if (activeTab == ActiveTab.Network)
            {
                <PeerNetworkPanel CurrentNodeUrl="@currentNodeUrl"
                                  CurrentNodeRole="@currentNodeRole"
                                  Snapshot="@peerDirectorySnapshot"
                                  SetupStatus="@nodeSetupStatus"
                                  NetworkStatus="@networkStatus"
                                  NetworkInvite="@networkInvite"
                                  IntentList="@intentListStatus"
                                  BrowserQueue="@browserQueuedOperations"
                                  MigrationChecklist="@migrationChecklist"
                                  UpdateCheck="@updateCheckStatus"
                                  NodeUrlInput="@nodeUrlInput"
                                  Peers="peerUrls"
                                  ConnectionStatus="@nodeConnectionStatus"
                                  IsBusy="isPeerPanelBusy"
                                  NodeUrlInputChanged="OnNodeUrlInputChanged"
                                  OnConnectNode="ConnectToNode"
                                  OnRefreshPeers="RefreshPeers"
                                  OnCreateSetupPlan="CreateSetupPlan"
                                  OnSetPeerTrust="SetPeerTrust"
                                  OnSetPeerRole="SetPeerRole"
                                  OnSyncNetwork="SyncNetwork"
                                  OnRetryBrowserQueue="RetryBrowserQueue"
                                  OnClearBrowserQueue="ClearBrowserQueue" />
            }
        </div>
    }
    else if (MyKeyService.IsLocked)
    {
        <div class="auth-empty-state">
            <div class="glass-card auth-empty-state__card">
                <span class="workspace-overview__eyebrow">Wallet locked</span>
                <h3 class="text-white fw-semibold mb-2">Unlock @MyKeyService.UserName</h3>
                <p class="text-muted mb-3">Your wallet session is stored encrypted. Unlock it to restore signing, realtime updates, and project access.</p>
                <div class="input-group mb-3">
                    <input type="password"
                           value="@unlockPassword"
                           @oninput="OnUnlockPasswordChanged"
                           class="form-control bg-dark text-white border-secondary"
                           placeholder="Wallet password"
                           aria-label="Wallet password" />
                    <button class="btn btn-primary" @onclick="UnlockWalletWithPassword">Unlock</button>
                </div>
                <button class="btn btn-outline-secondary w-100" @onclick="UnlockWalletWithPasskey">Unlock with passkey</button>
                @if (!string.IsNullOrWhiteSpace(unlockMessage))
                {
                    <div class="alert alert-warning py-2 mt-3 mb-0">@unlockMessage</div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="auth-empty-state">
            <div class="glass-card auth-empty-state__card">
                <span class="workspace-overview__eyebrow">Welcome</span>
                <h3 class="text-white fw-semibold mb-2">Sign in to Nexus Boards</h3>
                <p class="text-muted mb-0">Create or restore a wallet identity, then create or select a project workspace.</p>
            </div>
        </div>
    }

    @if (isMining)
    {
        <div class="modal-backdrop-custom" style="z-index: 9999;">
            <div class="glass-card p-5 text-center">
                <div class="spinner-border text-primary mb-4" style="width: 3rem; height: 3rem; border-width: 0.25em;" role="status"></div>
                <h3 class="text-white fw-semibold mb-2">Anchoring state</h3>
                <p class="text-muted font-monospace small mb-1">Validating Proof of Contribution event and block hash</p>
                <p class="text-warning font-monospace small mb-0">Hash target: 000</p>
            </div>
        </div>
    }

    <IssueModal @bind-IsOpen="isIssueModalOpen"
                IsNewTask="isNewTask"
                TaskModel="editingTask"
                ProjectMembers="projectMembers"
                OnSaveWithCredentials="HandleTaskSigningAndMining" />

    @if (viewingHistory != null)
    {
        <div class="modal-backdrop-custom">
            <div class="glass-card p-0 modal-content-custom animate-pop">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="m-0 text-white">Work Item History</h5>
                    <button class="btn btn-sm btn-outline-secondary border-0" @onclick="()=>viewingHistory=null">Close</button>
                </div>

                <div class="modal-scroll p-4" style="max-height: 500px; overflow-y: auto;">
                    @if (viewingHistory.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-warning mb-3" role="status"></div>
                            <div class="text-muted">Tracing blockchain history...</div>
                        </div>
                    }
                    else
                    {
                        <div class="timeline-container">
                            @foreach (var item in viewingHistory)
                            {
                                <div class="timeline-item @(item.Action == "Create" ? "active" : "")">
                                    <div class="timeline-dot"></div>
                                    <div class="glass-card p-3 ms-2 position-relative mb-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.05);">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge @(item.Action == "Create" ? "bg-primary" : (item.Action == "Move" ? "bg-warning text-dark" : "bg-secondary")) text-uppercase" style="font-size: 0.7rem;">@item.Action</span>
                                            <small class="text-white-50 font-monospace" style="font-size: 0.7rem;">@item.Timestamp</small>
                                        </div>
                                        <div class="mb-2">
                                            <span class="text-white-50 small">Status changed to: </span>
                                            <span class="fw-bold @(item.StatusLabel == "Done" ? "text-success" : (item.StatusLabel == "In Progress" ? "text-warning" : "text-white"))">@item.StatusLabel</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-end pt-2 border-top border-secondary mt-2">
                                            <small class="text-info d-flex align-items-center gap-1">@item.User</small>
                                            <small class="text-muted font-monospace bg-dark px-2 rounded" style="font-size: 0.65rem;">Block #@item.BlockIndex</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2500">
            <div class="toast show bg-dark border-primary text-white shadow-lg">
                <div class="toast-body d-flex justify-content-between align-items-center">
                    <span>@statusMessage</span>
                    <button class="btn-close ms-2" @onclick="()=>statusMessage=string.Empty"></button>
                </div>
            </div>
        </div>
    }
</div>

