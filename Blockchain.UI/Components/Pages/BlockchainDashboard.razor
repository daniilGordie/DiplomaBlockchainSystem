@page "/"
@using Blockchain.Node
@using Blockchain.UI.Services
@using Blockchain.UI.Components
@using System.Text.Json
@using System.Threading
@using System.Security.Cryptography
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@using System.IO
@using Google.Protobuf
@using Microsoft.JSInterop
@using System.Linq
@using System.Collections.Generic
@inject IJSRuntime JS
@inject BlockchainService.BlockchainServiceClient BlockchainClient
@inject KeyService MyKeyService
@inject Blockchain.UI.Services.IpfsService Ipfs
@using Blockchain.UI.Models

<PageTitle>Nexus Collaboration Platform</PageTitle>

<div class="dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 glass-panel">
        <div class="d-flex align-items-center gap-3">
            <div class="fs-2 animate-pulse">🚀</div>
            <div>
                <h2 class="m-0 fw-bold text-white">Nexus <span class="text-warning">Workplace</span></h2>
                <small class="text-muted">Multi-Project Decentralized Management</small>
            </div>
        </div>
        @if (MyKeyService.IsLoggedIn)
        {
            <div class="d-flex align-items-center gap-3">
                @if (myProjects.Count > 0)
                {
                    <select class="form-select form-select-sm bg-dark text-white border-warning shadow-sm" style="width: 150px;" @onchange="OnProjectChanged" value="@CurrentProjectId">
                        @foreach (var p in myProjects)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                }
                else
                {
                    <span class="badge bg-danger">No Projects</span>
                }

                <div class="input-group input-group-sm shadow-sm" style="width: 250px;">
                    <input @bind="newProjectName" class="form-control bg-dark text-white border-secondary" placeholder="New DAO Name..." />
                    <button class="btn btn-outline-warning fw-bold" @onclick="CreateNewProject" disabled="@isMining">Create</button>
                </div>
            </div>
        }
        <div>
            @if (!MyKeyService.IsLoggedIn)
            {
                <div class="input-group input-group-sm">
                    <input @bind="userNameInput" class="form-control bg-dark text-white border-secondary" placeholder="Your Name" />
                    <button @onclick="CreateWallet" class="btn btn-warning fw-bold">Login</button>
                    <button @onclick="RestoreMode" class="btn btn-outline-light">Restore</button>
                </div>
                @if (isRestoreMode)
                {
                    <div class="mt-2 position-absolute bg-dark p-3 rounded border border-secondary shadow-lg" style="right: 20px; z-index: 1000; width: 300px;">
                        <textarea @bind="restoreMnemonic" class="form-control mb-2 text-white bg-black border-secondary" placeholder="Private Key or Mnemonic..."></textarea>
                        <button @onclick="RestoreWallet" class="btn btn-info w-100 mb-2">Recover</button>
                        <button @onclick="()=>isRestoreMode=false" class="btn btn-sm btn-outline-secondary w-100">Cancel</button>
                    </div>
                }
            }
            else
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="fw-bold text-warning">@MyKeyService.UserName</div>
                        <div class="small text-white-50 font-monospace" style="font-size: 0.7rem;">@MyKeyService.PublicKey?.Substring(0, 12)...</div>
                    </div>
                    <button @onclick="Logout" class="btn btn-outline-danger btn-sm">Exit</button>
                </div>
            }
        </div>
    </div>

    @if (MyKeyService.IsLoggedIn && !string.IsNullOrEmpty(MyKeyService.CurrentMnemonic))
    {
        <div class="alert alert-danger mb-4 d-flex justify-content-between align-items-center shadow-sm" style="border-left: 5px solid #dc3545;">
            <div><strong>⚠️ SECRET PHRASE:</strong> <span class="font-monospace ms-2 text-white bg-danger bg-opacity-25 px-2 rounded">@MyKeyService.CurrentMnemonic</span></div>
            <button class="btn btn-sm btn-outline-light" @onclick="DismissMnemonic">I Saved It</button>
        </div>
    }

    @if (MyKeyService.IsLoggedIn)
    {
        <ul class="nav nav-pills mb-4 gap-2">
            <li class="nav-item">
                <button class="nav-link @(activeTab==ActiveTab.Board ? "active bg-warning text-dark fw-bold shadow" : "text-white bg-dark bg-opacity-25")" @onclick="()=>activeTab=ActiveTab.Board">📌 Task Board</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab==ActiveTab.Team ? "active bg-success text-white fw-bold shadow" : "text-white bg-dark bg-opacity-25")" @onclick="()=>activeTab=ActiveTab.Team">👥 Team & RBAC</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab==ActiveTab.Artifacts ? "active bg-info text-dark fw-bold shadow" : "text-white bg-dark bg-opacity-25")" @onclick="()=>activeTab=ActiveTab.Artifacts">📦 Releases & Assets</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab==ActiveTab.Analytics ? "active bg-danger text-white fw-bold shadow" : "text-white bg-dark bg-opacity-25")" @onclick="LoadAnalytics">📊 Analytics</button>
            </li>
        </ul>

        <div class="tab-content mb-5">
            @if (activeTab == ActiveTab.Board)
            {
                <div class="mb-4">
                    <button class="btn btn-primary fw-bold px-4 shadow-lg" @onclick="()=>OpenTaskModal(null)">+ Create Issue</button>
                </div>
                <TaskBoard Tasks="Tasks" OnTaskClick="OpenTaskModal" OnShowHistory="ShowHistory" />
            }

            @if (activeTab == ActiveTab.Team)
            {
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="glass-card p-4 h-100" style="border: 1px solid rgba(255,193,7,0.3); background: rgba(20, 20, 25, 0.8);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="text-warning mb-0">🛡️ DAO Team Management</h4>
                                <span class="badge bg-secondary">Project: @CurrentProjectId</span>
                            </div>
                            <p class="text-muted" style="font-size: 0.9rem;">Blockchain Access Control. Only the <strong>Owner</strong> can grant access to this project workspace.</p>
                            <div class="input-group mt-3 shadow-sm">
                                <span class="input-group-text border-0" style="background: #2b2b36; color: #adb5bd;">@("@")</span>
                                <input @bind="newMemberName" class="form-control text-white shadow-none border-0" placeholder="Developer Nickname..." style="background: #2b2b36;" />
                                <select @bind="newMemberRole" class="form-select text-white shadow-none border-0" style="background: #3f3f4e; max-width: 130px;">
                                    <option value="Developer">Developer</option>
                                    <option value="QA">QA</option>
                                    <option value="Observer">Observer</option>
                                </select>
                                <button class="btn btn-primary fw-bold" @onclick="InviteMember" disabled="@isMining">2. Grant Access & Mine</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="glass-card p-4 h-100" style="border-left: 3px solid var(--neon-accent);">
                            <h4 class="text-warning mb-3">💸 P2P Token Transfer</h4>
                            <p class="text-muted small mb-4">Send NXP tokens to team members. Checked by <span class="text-warning font-monospace">ReputationContract</span>.</p>
                            <div class="mb-3">
                                <label class="form-label text-white-50">Recipient Name</label>
                                <input @bind="targetTransferUser" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Bob" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label text-white-50">Amount (NXP)</label>
                                <input type="number" @bind="transferAmount" class="form-control bg-dark text-white border-secondary" min="1" />
                            </div>
                            <button class="btn btn-warning w-100 fw-bold text-dark" @onclick="TransferTokens" disabled="@(!MyKeyService.IsLoggedIn)">Send Funds</button>
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == ActiveTab.Artifacts)
            {
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h5 class="text-white mb-1">📦 Project Releases & Media Assets</h5>
                            <small class="text-white-50">Direct upload of compiled binaries (.exe, .apk), archives, and media to IPFS.</small>
                        </div>

                        <a href="/repo/@CurrentProjectId" class="btn btn-outline-warning fw-bold shadow-sm d-flex align-items-center gap-2">
                            <span>🌐</span> Open Project Repository
                        </a>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="p-4 rounded border border-secondary" style="background: rgba(0,0,0,0.3);">
                                <h6 class="text-white mb-3">Upload New Asset</h6>

                                <div class="mb-3">
                                    <label class="form-label text-muted small">Select a file (Max 50MB)</label>
                                    <InputFile OnChange="HandleFileUpload" class="form-control bg-dark text-white border-secondary" disabled="@(isUploading || !MyKeyService.IsLoggedIn)" />
                                </div>

                                @if (isUploading)
                                {
                                    <div class="alert alert-warning py-2 d-flex align-items-center gap-2 border-warning bg-transparent text-warning">
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                        @statusMessage
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(statusMessage))
                                {
                                    <div class="alert alert-success py-2 bg-transparent border-success text-success">
                                        ✔ @statusMessage
                                    </div>
                                }

                                <div class="alert alert-info py-2 mt-3 bg-transparent border-info text-info small mb-0">
                                    <strong>ℹ️ How it works:</strong> The file is uploaded to the decentralized IPFS network. Only its cryptographic CID (hash) is anchored to the blockchain.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="p-3 rounded border border-secondary h-100" style="background: rgba(0,0,0,0.3);">
                                <h6 class="text-white mb-3">Recent Uploads (IPFS CID)</h6>
                                <div style="max-height: 250px; overflow-y: auto;">
                                    @if (!Artifacts.Any())
                                    {
                                        <div class="text-muted text-center py-4">No assets uploaded yet.</div>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush bg-transparent">
                                            @foreach (var a in Artifacts.Take(5)) 
                                            {
                                                <li class="list-group-item bg-transparent border-secondary px-0 d-flex justify-content-between align-items-center hover-bg">
                                                    <div class="text-truncate pe-3">
                                                        <div class="text-white fw-bold">📄 @a.FileName</div>
                                                        <div class="small text-info font-monospace text-truncate" style="max-width: 250px;">@a.FileHash</div>
                                                    </div>
                                                    <a href="http://127.0.0.1:8080/ipfs/@a.FileHash" target="_blank" class="btn btn-sm btn-outline-info flex-shrink-0">Download</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (activeTab == ActiveTab.Analytics)
            {
                <div class="row g-4">
                    <div class="col-md-3"><div class="glass-card p-3 text-center border-bottom border-4 border-light"><h3 class="fw-bold text-white m-0">@analyticsData.TotalBlocks</h3><div class="text-white-50 small text-uppercase">Blocks Mined</div></div></div>
                    <div class="col-md-3"><div class="glass-card p-3 text-center border-bottom border-4 border-info"><h3 class="fw-bold text-info m-0">@analyticsData.TotalTasks</h3><div class="text-white-50 small text-uppercase">Tasks Managed</div></div></div>
                    <div class="col-md-3"><div class="glass-card p-3 text-center border-bottom border-4 border-success"><h3 class="fw-bold text-success m-0">@analyticsData.TasksDone</h3><div class="text-white-50 small text-uppercase">Completed</div></div></div>
                    <div class="col-md-3"><div class="glass-card p-3 text-center border-bottom border-4 border-warning"><h3 class="fw-bold text-warning m-0">@analyticsData.TotalArtifacts</h3><div class="text-white-50 small text-uppercase">Files Secured</div></div></div>

                    <div class="col-md-8">
                        <div class="glass-card p-4 h-100">
                            <div class="d-flex justify-content-between mb-4"><h5 class="text-white m-0">🏆 Real SQL Balances (NXP)</h5><span class="badge bg-warning text-dark">+5 Create | +20 Done</span></div>
                            <table class="table table-dark table-hover mb-0" style="background:transparent;">
                                <thead><tr><th class="text-muted">Rank</th><th class="text-muted">User</th><th class="text-end text-muted">Wallet Balance</th><th class="text-end text-muted">Share</th></tr></thead>
                                <tbody>
                                    @{
                                        int r = 1; int tot = analyticsData.UserReputation.Values.Sum();
                                    }
                                    @foreach (var u in analyticsData.UserReputation.OrderByDescending(x => x.Value))
                                    {
                                        <tr>
                                            <td>
                                                @if (r == 1)
                                                {
                                                    <span>🥇</span>
                                                }
                                                else if (r == 2)
                                                {
                                                    <span>🥈</span>
                                                }
                                                else if (r == 3)
                                                {
                                                    <span>🥉</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">#@r</span>
                                                }
                                            </td>
                                            <td class="fw-bold @(u.Key==MyKeyService.UserName?"text-warning":"text-white")">@u.Key @(u.Key == MyKeyService.UserName ? "(You)" : "")</td>
                                            <td class="text-end text-info font-monospace">@u.Value NXP</td>
                                            <td class="text-end"><div class="progress bg-dark border border-secondary" style="height:6px;width:100px;display:inline-flex;"><div class="progress-bar bg-info" style="width:@(tot>0?(u.Value*100/tot):0)%"></div></div></td>
                                        </tr>
                                        r++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="glass-card p-4 h-100">
                            <h5 class="text-white mb-4">Work Distribution</h5>
                            <div class="d-flex flex-column gap-3 justify-content-center h-75">
                                <div>
                                    <div class="d-flex justify-content-between small text-muted mb-1"><span>To Do (@analyticsData.TasksTodo)</span><span class="text-white-50">@GetPercent(analyticsData.TasksTodo)%</span></div>
                                    <div class="progress" style="height: 10px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-secondary" style="width: @(GetPercent(analyticsData.TasksTodo))%"></div></div>
                                </div>
                                <div>
                                    <div class="d-flex justify-content-between small text-muted mb-1"><span>In Progress (@analyticsData.TasksInProgress)</span><span class="text-warning">@GetPercent(analyticsData.TasksInProgress)%</span></div>
                                    <div class="progress" style="height: 10px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-warning" style="width: @(GetPercent(analyticsData.TasksInProgress))%"></div></div>
                                </div>
                                <div>
                                    <div class="d-flex justify-content-between small text-muted mb-1"><span>Done (@analyticsData.TasksDone)</span><span class="text-success">@GetPercent(analyticsData.TasksDone)%</span></div>
                                    <div class="progress" style="height: 10px; background: rgba(255,255,255,0.1);"><div class="progress-bar bg-success" style="width: @(GetPercent(analyticsData.TasksDone))%"></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center mt-5" style="min-height: 50vh;">
            <div class="glass-card p-5 text-center shadow-lg" style="max-width: 600px; border-top: 4px solid #ffc107;">
                <div class="fs-1 mb-4 animate-bounce">🔐</div>
                <h3 class="text-white fw-bold mb-3">Zero-Trust Workspace</h3>
                <p class="text-muted mb-4" style="font-size: 1.1rem;">You are currently disconnected from the blockchain network.</p>
                <div class="p-3 rounded bg-dark border border-secondary mb-0">
                    <p class="text-white-50 small mb-0">Use the controls in the top right corner to <strong class="text-white">Login</strong> and generate a new cryptographic identity, or <strong class="text-white">Restore</strong> an existing wallet to access the project data.</p>
                </div>
            </div>
        </div>
    }

    @if (isMining)
    {
        <div class="modal-backdrop-custom" style="z-index: 9999;">
            <div class="glass-card p-5 text-center shadow-lg" style="border: 2px solid #ffc107; background: rgba(20,20,25,0.95);">
                <div class="spinner-border text-warning mb-4" style="width: 4rem; height: 4rem; border-width: 0.3em;" role="status"></div>
                <h3 class="text-white fw-bold mb-2">⛏️ Mining Block...</h3>
                <p class="text-muted font-monospace small mb-1">Calculating SHA-256 Proof of Work</p>
                <p class="text-warning font-monospace small mb-0">Target difficulty: 000...</p>
            </div>
        </div>
    }

    <IssueModal @bind-IsOpen="isTaskModalOpen"
                TaskModel="currentTaskModel"
                IsNewTask="isNewTask"
                IsLoggedIn="MyKeyService.IsLoggedIn"
                OnSave="SaveTaskModal" />

    @if (selectedBlock != null)
    {
        <div class="modal-backdrop-custom">
            <div class="glass-card p-0 modal-content-custom animate-pop">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="m-0 text-white">📦 Block Inspector <span class="text-warning">#@selectedBlock.Index</span></h5>
                    <button class="btn btn-sm btn-outline-light border-0" @onclick="()=>selectedBlock=null">✕</button>
                </div>
                <div class="modal-scroll p-4" style="overflow-y: auto;">
                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase">Block Hash (Proof of Work)</label>
                        <div class="p-2 bg-black rounded text-warning fw-bold font-monospace small border border-warning text-break">@selectedBlock.Hash</div>
                        <small class="text-muted">Nonce used: @selectedBlock.Nonce</small>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase">Validator Identity</label>
                        <div class="p-2 bg-black rounded text-info font-monospace small border border-info text-break" style="max-height:80px;overflow-y:auto;">@selectedBlock.ValidatorPublicKey</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase">Timestamp</label>
                        <div class="text-white font-monospace">@selectedBlock.Timestamp</div>
                    </div>
                    <div class="mb-2">
                        <label class="text-muted small fw-bold text-uppercase">Payload Data</label>
                        <pre class="p-3 bg-dark rounded text-success font-monospace small border border-success mb-0" style="white-space:pre-wrap;">@FormatJson(selectedBlock.Data)</pre>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (viewingHistory != null)
    {
        <div class="modal-backdrop-custom">
            <div class="glass-card p-0 modal-content-custom animate-pop" style="border: 1px solid #ffc107;">
                <div class="p-3 bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="m-0 text-white">🕒 Task History & Versioning</h5>
                    <button class="btn btn-sm btn-outline-light border-0" @onclick="()=>viewingHistory=null">✕</button>
                </div>

                <div class="modal-scroll p-4" style="max-height: 500px; overflow-y: auto; background: rgba(0,0,0,0.2);">
                    @if (viewingHistory.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-warning mb-3" role="status"></div>
                            <div class="text-muted">Tracing blockchain history...</div>
                        </div>
                    }
                    else
                    {
                        <div class="timeline-container">
                            @foreach (var item in viewingHistory)
                            {
                                <div class="timeline-item @(item.Action == "Create" ? "active" : "")">
                                    <div class="timeline-dot"></div>
                                    <div class="glass-card p-3 ms-2 position-relative mb-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.05);">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge @(item.Action == "Create" ? "bg-primary" : (item.Action == "Move" ? "bg-warning text-dark" : "bg-secondary")) text-uppercase" style="font-size: 0.7rem;">@item.Action</span>
                                            <small class="text-white-50 font-monospace" style="font-size: 0.7rem;">@item.Timestamp</small>
                                        </div>
                                        <div class="mb-2">
                                            <span class="text-white-50 small">Status changed to: </span>
                                            <span class="fw-bold @(item.StatusLabel == "Done" ? "text-success" : (item.StatusLabel == "In Progress" ? "text-warning" : "text-white"))">@item.StatusLabel</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-end pt-2 border-top border-secondary mt-2">
                                            <small class="text-info d-flex align-items-center gap-1">👤 @item.User</small>
                                            <small class="text-muted font-monospace bg-dark px-2 rounded" style="font-size: 0.65rem;">Block #@item.BlockIndex</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2500">
            <div class="toast show bg-dark border-primary text-white shadow-lg">
                <div class="toast-body d-flex justify-content-between align-items-center">
                    <span>@statusMessage</span>
                    <button class="btn-close btn-close-white ms-2" @onclick="()=>statusMessage=null"></button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ActiveTab activeTab = ActiveTab.Board;
    private List<ProjectTask> Tasks = new();
    private List<CommitPayloadUI> Commits = new();
    private List<ArtifactPayloadUI> Artifacts = new();
    private List<BlockModel> chain = new();
    private BlockModel? selectedBlock = null;
    private AnalyticsResponse analyticsData = new();
    private List<TaskHistoryItem>? viewingHistory = null;
    private List<string> myProjects = new();

    private string localRepoName = "nexus-core";
    private string localCommitMessage = "";
    private string localCommitHash = "";
    private string newProjectName = "";
    private string newMemberName = "";
    private string newMemberRole = "Developer";
    private string CurrentProjectId = "Alpha";
    private string userNameInput = "";
    private string restoreMnemonic = "";
    private string statusMessage = "";
    private bool isRestoreMode = false;
    private bool isLoading = false;
    private bool isUploading = false;
    private bool isMining = false;

    private string targetRoleUser = "";
    private string targetRole = "Worker";
    private string targetTransferUser = "";
    private int transferAmount = 5;

    private bool isTaskModalOpen = false;
    private bool isNewTask = false;
    private ProjectTask currentTaskModel = new();

    protected override async Task OnInitializedAsync()
    {
        await SyncChain();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await MyKeyService.LoadFromStorage();
            StateHasChanged();
        }
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        CurrentProjectId = e.Value?.ToString() ?? "Alpha";

        await SyncChain();
    }

    private async Task InviteMember()
    {
        if (string.IsNullOrWhiteSpace(newMemberName)) return;

        var payload = new
        {
            Type = "AssignRole",
            User = MyKeyService.UserName,
            ProjectId = CurrentProjectId,
            TargetUser = newMemberName,
            Role = newMemberRole,
            Timestamp = DateTime.UtcNow.ToString("O")
        };

        await SendJsonBlock(payload);
        newMemberName = "";
    }
