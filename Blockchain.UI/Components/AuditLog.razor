@using Blockchain.Node

<div class="row g-4">
    <div class="col-12">
        <div class="glass-card h-100 p-0 overflow-hidden d-flex flex-column">
            <div class="p-3 bg-dark bg-opacity-50 d-flex justify-content-between align-items-center border-bottom border-secondary">
                <h6 class="m-0 text-white">🔍 Audit Log <small class="text-muted ms-2">(Real-time Blockchain Feed)</small></h6>
                <span class="badge bg-secondary">@Chain.Count blocks</span>
            </div>
            <div class="chain-scroll-view p-2" style="max-height:300px; overflow-y:auto;">
                @foreach (var b in Enumerable.Reverse(Chain))
                {
                    <div class="d-flex align-items-center gap-3 border-bottom py-2 px-3 border-secondary block-row rounded mb-1 hover-bg" @onclick="() => OnBlockSelect.InvokeAsync(b)" style="cursor:pointer; transition: background 0.2s;">
                        <span class="badge bg-dark border border-secondary">#@b.Index</span>
                        <div class="text-truncate flex-grow-1 font-monospace small text-white-50">@b.Hash</div>
                        <div class="small text-muted">🔎 Inspect</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<BlockModel> Chain { get; set; } = new();
    [Parameter] public EventCallback<BlockModel> OnBlockSelect { get; set; }
}